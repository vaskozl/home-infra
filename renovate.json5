{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':automergeBranch',
    ':automergePatch',
    ':automergeDigest',
    ':skipStatusChecks',
    ':disableRateLimiting',
    ':dependencyDashboard',
    'group:allDigest',
  ],
  recreateWhen: 'always',
  enabledManagers: [
    'custom.regex',
    'flux',
    'helm-values',
    'kubernetes',
    'docker-compose',
    'github-actions',
    'gitlabci',
    'dockerfile',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard',
  },
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  commitMessageTopic: '{{depName}}',
  commitMessageExtra: 'to {{newVersion}}',
  ignoreDeps: [
    'ghcr.io/fluxcd/helm-controller',
    'ghcr.io/fluxcd/image-automation-controller',
    'ghcr.io/fluxcd/image-reflector-controller',
    'ghcr.io/fluxcd/kustomize-controller',
    'ghcr.io/fluxcd/notification-controller',
    'ghcr.io/fluxcd/source-controller',
  ],
  flux: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  'docker-compose': {
    managerFilePatterns: [
      '/nas/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchManagers: [
        'flux',
      ],
      pinDigests: false,
    },
    {
      matchPackageNames: [
        'ghcr.io/vaskozl/prometheus-node-exporter',
      ],
      pinDigests: false,
    },
    {
      matchDatasources: [
        'helm',
      ],
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/gethomepage/homepage',
        'ghcr.io/vaskozl/cyberchef-web',
        'ghcr.io/vaskozl/flate',
        'ghcr.io/vaskozl/oauth2-proxy',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/vaskozl/cloudflared',
        'ghcr.io/home-assistant/home-assistant',
        'ghcr.io/vaskozl/renovate',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      automerge: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      groupName: 'immich',
      sourceUrl: 'https://github.com/immich-app/immich',
      matchPackageNames: [
        '/^ghcr\\.io/immich-app//',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      groupName: 'cert-manager',
      sourceUrl: 'https://github.com/cert-manager/cert-manager',
      matchPackageNames: [
        '/^ghcr\\.io/vaskozl/cert-manager-/',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      groupName: 'gitlab',
      sourceUrl: 'https://gitlab.com/gitlab-org/build/CNG/',
      matchPackageNames: [
        '/^ghcr\\.io/vaskozl/gitlab/',
        '/^ghcr\\.io/vaskozl/gitaly$/',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/vaskozl/postgresql',
        'ghcr.io/immich-app/postgres',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/vaskozl/fluent-bit',
      ],
      matchFileNames: [
        'cluster/logging/fluent-aggregator/hr.yaml',
      ],
      allowedVersions: '<5.0.6',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/pocket-id/pocket-id',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/agentgateway/charts/agentgateway',
        'ghcr.io/agentgateway/charts/agentgateway-crds',
      ],
      allowedVersions: '<2.0.0',
    },
  ],
}
