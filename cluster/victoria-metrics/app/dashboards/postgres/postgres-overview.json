      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{namespace=~\"$namespace\",job=~\"$job\",instance=~\"$instance\",datname=~\"$db\"}[$__rate_interval])) + sum(rate(pg_stat_database_xact_rollback{namespace=~\"$namespace\",job=~\"$job\",instance=~\"$instance\",datname=~\"$db\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
